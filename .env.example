# Copy to .env. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
TRANSLATION_VERSION=azsembench-pair-v2
TRANSLATION_CACHE=data/cache/translations_openai_gpt54_batch.sqlite
SOURCE_DIR=data/source
REVIEWED_DIR=data/reviewed
BUILD_DIR=data/build
MODEL_READY_DIR=data/model_ready
BATCH_STATE_DIR=data/cache/batch_jobs
PAIRS_PER_REQUEST=10
REQUESTS_PER_BATCH=100
MAX_OUTPUT_TOKENS=8192
POLL_SECONDS=30
MAX_RETRIES=3
AZSEMBENCH_REPO=MehribanAliyeva/azsembench
AZSEMBENCH_REF=main
